# syntax=docker/dockerfile:1
FROM rust:1.99.1-bookworm@sha256:e12566d5abc17a0da741628782cdb504b68b8961f5bfcf677936bf3e8b32de29 AS build
WORKDIR /src
COPY apps/server/ ./
RUN cargo build --release --locked --bin nuvex-server

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 nuvex \
    && useradd --uid 10001 --gid nuvex --no-create-home --shell /usr/sbin/nologin nuvex
COPY --from=build /src/target/release/nuvex-server /usr/local/bin/nuvex-server
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /usr/share/doc/nuvex/
USER nuvex:nuvex
EXPOSE 3001
ENTRYPOINT ["nuvex-server"]
