# Copia a .env y aporta tus propias claves. Los valores obligatorios vacíos impiden el inicio.
# Genera CADA contraseña por separado: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
# Al menos 64 caracteres hexadecimales; se usa en una URI de conexión sin escapar.
NUVEX_DATABASE_PASSWORD=
NUVEX_DATABASE_NAME=nuvex

# Origen exacto obligatorio, sin barra final: https://chat.tu-dominio.example
NUVEX_ALLOWED_ORIGIN=
# Orígenes adicionales de API, separados por comas, incorporados al compilar.
# Vacío permite solo el mismo origen. Vuelve a compilar la web al cambiarlo.
# Solo HTTPS o HTTP local; nunca añadas claves ni enlaces de invitación aquí.
NUVEX_CONNECT_ORIGINS=
# Conserva false con HTTPS. Ejemplo solo local: origen http://127.0.0.1:8080 y true.
NUVEX_INSECURE_DEV=false
# Actívalo expresamente para permitir registro de cuentas en tu instancia.
NUVEX_REGISTRATION_OPEN=false

# Voz WebRTC: vacío usa STUN de Cloudflare; [] permite solo candidatos locales.
# Para redes restrictivas, configura los servidores TURN del operador en JSON.
# Las credenciales TURN deben tener alcance y caducidad limitados; no las publiques.
NUVEX_VOICE_ICE_SERVERS=

# El HTTPS público debe terminar en un proxy de confianza del mismo servidor.
NUVEX_WEB_BIND=127.0.0.1
NUVEX_WEB_PORT=8080
# Deben describir la misma subred Docker libre; la API confía solo en esta IP web /32.
NUVEX_EDGE_SUBNET=172.29.251.0/24
NUVEX_WEB_INTERNAL_IP=172.29.251.10
