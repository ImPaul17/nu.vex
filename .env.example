# Copy to .env and supply your own secrets. Blank required values fail closed.
# Generate EACH password independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
# At least 64 hexadecimal characters; used in a connection URI without escaping.
NUVEX_DATABASE_PASSWORD=
NUVEX_DATABASE_NAME=nuvex

# Required exact origin, with no trailing slash: https://chat.your-domain.example
NUVEX_ALLOWED_ORIGIN=
# Keep false for HTTPS deployments. Local-only example: origin http://127.0.0.1:8080 and true.
NUVEX_INSECURE_DEV=false
# Deliberately enable to allow account registration on your own instance.
NUVEX_REGISTRATION_OPEN=false

# Public HTTPS should terminate in a trusted reverse proxy on the same host.
NUVEX_WEB_BIND=127.0.0.1
NUVEX_WEB_PORT=8080
# These must describe the same unused Docker subnet; the API trusts only this web IP /32.
NUVEX_EDGE_SUBNET=172.29.251.0/24
NUVEX_WEB_INTERNAL_IP=172.29.251.10
